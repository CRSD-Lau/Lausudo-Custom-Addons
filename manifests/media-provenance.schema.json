{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CRSD-Lau/Lausudo-Custom-Addons/raw/main/manifests/media-provenance.schema.json",
  "title": "Bundled binary and media provenance records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "allowedRoots"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "allowedRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source", "license", "licensePath"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$" },
          "source": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "licensePath": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
